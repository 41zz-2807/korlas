# Template lingkungan produksi untuk container Korlas.
# Salin sebagai `.env.docker` di server, lalu isi nilai secret, contoh:
#   cp docker/env.template .env.docker
#   (edit ADMIN_PASSWORD, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, SCHOOL_NAME)
# Variabel ${NAMA} pada file ini otomatis diisi dari lingkungan container
# (disediakan docker-compose via env_file) saat image pertama kali dijalankan.

APP_NAME=Korlas
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:7474

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=/data/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Korlas"

ADMIN_USERNAME=${ADMIN_USERNAME}
ADMIN_PASSWORD=${ADMIN_PASSWORD}

TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
TELEGRAM_CHAT_ID=${TELEGRAM_CHAT_ID}

SCHOOL_NAME="${SCHOOL_NAME}"
SCHOOL_SUBTITLE="${SCHOOL_SUBTITLE}"

VITE_APP_NAME="Korlas"